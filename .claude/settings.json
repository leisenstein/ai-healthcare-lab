{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet add:*)",
      "Bash(docker compose:*)",
      "Bash(git diff:*)"
    ],
    "deny": [ "Read(./.env)" ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet format whitespace"
          }
        ]
      }
    ]
  }
}